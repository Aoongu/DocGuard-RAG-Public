# Never commit real credentials. S7 real runs require this value at process runtime.
OPENAI_API_KEY=
# If set, these must match the frozen S7 config exactly.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini-2026-03-17

# DeepSeek Responses real runs use a separate credential namespace.
DEEPSEEK_API_KEY=
# If set, these must match configs/generation/s7-deepseek-flash-v1.json exactly.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# S9 resolves versioned configs from PROJECT_ROOT and ignored models/indexes from ASSET_ROOT.
# Leave both empty when running from a fully prepared repository checkout.
DOCGUARD_PROJECT_ROOT=
DOCGUARD_ASSET_ROOT=

# S15 natural-language discovery uses DeepSeek plus a separate search service.
# Application reads process environment; local launcher and Docker Compose load root .env.
# Default: serpapi. Set brave explicitly to use the legacy Brave adapter.
DOCGUARD_SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=
DOCGUARD_DISCOVERY_ROOT=
# Optional S15 document fetch resolution: system (default), or fixed-provider DoH.
# DoH is explicit; public-IP, TLS and robots checks remain enabled.
DOCGUARD_DOCUMENT_DNS=system
DOCGUARD_DOH_PROVIDER=auto
