# Never commit real credentials. S7 real runs require this value at process runtime.
OPENAI_API_KEY=
# If set, these must match the frozen S7 config exactly.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini-2026-03-17

# DeepSeek Responses real runs use a separate credential namespace.
DEEPSEEK_API_KEY=
# If set, these must match configs/generation/s7-deepseek-flash-v1.json exactly.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# S9 resolves versioned configs from PROJECT_ROOT and ignored models/indexes from ASSET_ROOT.
# Leave both empty when running from a fully prepared repository checkout.
DOCGUARD_PROJECT_ROOT=
DOCGUARD_ASSET_ROOT=
