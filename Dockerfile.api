FROM python:3.11.15-slim-bookworm AS builder

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_HTTP_TIMEOUT=120 UV_HTTP_RETRIES=3 PIP_DEFAULT_TIMEOUT=120
WORKDIR /app
RUN pip install --no-cache-dir uv==0.11.13
COPY pyproject.toml uv.lock README.md /app/
COPY baseline /app/baseline
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project
COPY . /app
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev

FROM python:3.11.15-slim-bookworm AS runtime
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DOCGUARD_PROJECT_ROOT=/app \
    DOCGUARD_ASSET_ROOT=/workspace
RUN groupadd --system docguard && useradd --system --gid docguard --home /app docguard \
    && mkdir -p /workspace/reports/generated \
    && chown -R docguard:docguard /workspace
WORKDIR /app
COPY --from=builder --chown=docguard:docguard /app /app
USER docguard
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=3)"]
CMD ["uvicorn", "docguard.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
